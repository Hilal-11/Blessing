{
  "expo": {
    "name": "blessing",
    "slug": "blessing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Assets/blessing2.png",
    "scheme": "blessing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hilal.blessing",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Blessing uses your location to show nearby Blessings and Needs."
      }
    },
    "android": {
      "package": "com.hilal.blessing",
      "adaptiveIcon": {
        "foregroundImage": "./assets/expo.icon/Assets/blessing2.png",
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/expo.icon/Assets/blessing2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Blessing uses your location to show nearby Blessings and Needs, and to set the pickup point when you give something."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Blessing needs access to your photos so you can add pictures to what you're giving.",
          "cameraPermission": "Blessing needs camera access so you can take a photo of what you're giving."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/expo.icon/Assets/blessing2.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-sqlite",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}